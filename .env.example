# Fake placeholder values only. Copy to .env (never commit .env).
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_API_KEY=your-api-key-here
AZURE_OPENAI_DEPLOYMENT=your-deployment-name
AZURE_OPENAI_API_VERSION=2024-06-01

# OCR engine: tesseract (default) or azure_di
OCR_ENGINE=tesseract
# TESSERACT_CMD=C:\path\to\tesseract.exe
# AZURE_DI_ENDPOINT=https://your-di-resource.cognitiveservices.azure.com/
# AZURE_DI_KEY=your-di-key-here

# Alternative to Azure OpenAI: any OpenAI-compatible endpoint
# OPENAI_API_KEY=your-api-key-here
# OPENAI_BASE_URL=https://api.example.com/v1
# OPENAI_MODEL=your-model-name
